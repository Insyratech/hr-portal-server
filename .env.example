PORT=3001
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000

# Server-only. Never copy these into Client or NEXT_PUBLIC_* variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Header x-cron-secret for POST /api/v1/jobs/* (Supabase Cron)
CRON_SECRET=
# Used only by npm run seed — see scripts/SEED.md
SEED_PASSWORD=
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_GM_EMAIL=gm@example.com
# Legacy alias for GM (ex-ADMIN). Prefer SEED_GM_EMAIL.
SEED_ADMIN_EMAIL=gm@example.com
SEED_HR_EMAIL=hr@example.com
SEED_EMPLOYEE_EMAIL=employee@example.com
SEED_CSO_EMAIL=cso@example.com
SEED_FINANCE_EMAIL=finance@example.com
# Set false to skip CSO and Finance Manager seeds
SEED_OPTIONAL_ROLES=true

# Optional. Leave empty to skip outbound mail.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=HR Portal

# Push notifications (Phase 2).
# Android APK: set FIREBASE_* (required for system push).
# iOS: employees use Safari PWA — no APNS needed until native iOS app (paid Apple Developer).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional — only when shipping native iOS app + APNs (Apple Developer $99/year).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.insyratech.hrportal
APNS_PRIVATE_KEY=
APNS_USE_SANDBOX=false
